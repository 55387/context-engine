
# Context Engine Configuration
# ============================

# --- LLM Provider Settings ---

# Primary LLM Provider (gemini | mock)
LLM_PROVIDER=gemini

# Google Gemini API Key (Required for 'gemini' provider)
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# (Optional) Alternative env var for Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# --- Security Settings ---

# Application Secret Key
# Used for encrypting sensitive data at rest (e.g., memory facts)
# Must be at least 32 characters for AES-256
APP_SECRET=your_super_secret_key_at_least_32_chars_long_123

# --- Storage Settings ---

# Storage Type (memory | filesystem | sqlite)
# - memory: In-memory storage (data lost on restart)
# - filesystem: File-based storage with JSON
# - sqlite: SQLite database with transactions
STORAGE_TYPE=filesystem

# Base directory for file-based storage
# Defaults to ./data if not specified
STORAGE_BASE_DIR=./data

# SQLite database path (only used when STORAGE_TYPE=sqlite)
# Defaults to ./data/memories.db if not specified
SQLITE_DB_PATH=./data/memories.db

# --- Observability Settings ---

# Log Level (debug | info | warn | error)
LOG_LEVEL=info

# Enable Metrics Collection (true | false)
METRICS_ENABLED=true

# --- Application Settings ---

# Max Context Tokens (Context Window Size)
# Default: 128000 (Gemini 1.5 Pro)
MAX_CONTEXT_TOKENS=128000

# System Instructions / Persona
SYSTEM_INSTRUCTIONS="You are a helpful AI assistant with long-term memory."
